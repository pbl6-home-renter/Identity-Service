# Application Configuration
APP_NAME=MyApp

PORT=3001
NODE_ENV=dev
API_DOMAIN=localhost
API_VERSION=1.0.0
ENABLE_DOCUMENTATION=true
LOG_LEVEL=debug

# Database Configuration (Supabase PostgreSQL or local PostgreSQL)
DATABASE_URL=
MIGRATION_DATABASE_URL=
KEEPALIVE_DATABASE_URL=
DB_SSL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=identity_db
ENABLE_ORM_LOGS=false

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_for_development_min_32_chars

# RabbitMQ Message Broker (Optional)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis Cache (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP Mailer (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=noreply@example.com

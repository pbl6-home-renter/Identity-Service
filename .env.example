# Application Configuration
APP_NAME=MyApp

PORT=3001
NODE_ENV=dev
API_DOMAIN=localhost
API_VERSION=1.0.0
ENABLE_DOCUMENTATION=true
LOG_LEVEL=debug

# Database Configuration (Supabase PostgreSQL or local PostgreSQL)
DATABASE_URL=
MIGRATION_DATABASE_URL=
KEEPALIVE_DATABASE_URL=
DB_SSL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=identity_db
ENABLE_ORM_LOGS=false

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_for_development_min_32_chars

# RabbitMQ Message Broker (Optional)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis Cache (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Default Admin Account Configuration (For Seeding)
DEFAULT_ADMIN_ID=00000000-0000-4000-8000-000000000001
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=AdminPassword123!
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_PHONE=0900000000


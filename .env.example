APP_NAME=MyApp
PORT=3001
NODE_ENV=dev
API_DOMAIN=localhost
API_VERSION=1.0.0
ENABLE_DOCUMENTATION=true
LOG_LEVEL=debug

# Database Configuration (PostgreSQL/Supabase)
DATABASE_URL=
MIGRATION_DATABASE_URL=
KEEPALIVE_DATABASE_URL=
DB_SSL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=identity_db
ENABLE_ORM_LOGS=false

# JWT Configuration (RS256)
# Store PEM values with literal \n escapes in environment variables.
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_KEY_ID=rentify-identity-2026-01
JWT_ISSUER=rentify-identity
JWT_AUDIENCE=rentify-api

# RabbitMQ Message Broker
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=MyApp.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_PREFETCH=10
RABBITMQ_CONNECT_TIMEOUT_MS=10000
RABBITMQ_CONSUMER_MAX_ATTEMPTS=5
RABBITMQ_CONSUMER_RETRY_DELAY_MS=10000

# Transactional Outbox
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_PUBLISH_TIMEOUT_MS=5000
OUTBOX_CLAIM_TIMEOUT_MS=60000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=60000
OUTBOX_RETENTION_MS=604800000

# Redis Cache (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Default Admin Account Configuration (For Seeding)
DEFAULT_ADMIN_ID=00000000-0000-4000-8000-000000000001
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=AdminPassword123!
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_PHONE=0900000000
